PORT=5001
DATABASE_URL=postgresql://username:password@hostname:5432/dbname?sslmode=require
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development

# CORS allowlist: *.vercel.app and local dev servers are supported automatically.
# Set CLIENT_URL or CORS_ORIGIN on Render if you use a custom domain or wish to be explicit:
CLIENT_URL=https://your-project.vercel.app
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Optional: where maintenance receipt files are stored (default: server/storage/maintenance-receipts)
# MAINTENANCE_RECEIPTS_DIR=

# Optional: how close (metres) a driver must be to the pickup/drop-off to mark a trip loaded/unloaded (default 3000)
# MILESTONE_RADIUS_M=3000