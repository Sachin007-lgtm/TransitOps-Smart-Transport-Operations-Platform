PORT=5001
DATABASE_URL=postgresql://username:password@hostname:5432/dbname?sslmode=require
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development

# CORS allowlist (comma-separated origins the dashboard may call from).
# Defaults to the local dev servers; set this to your real dashboard origin(s) in production.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Optional: where maintenance receipt files are stored (default: server/storage/maintenance-receipts)
# MAINTENANCE_RECEIPTS_DIR=